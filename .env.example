# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dev_metric?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dev_metric_test"

# Authentication & Encryption
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-char-minimum-nextauth-secret-here"


GITHUB_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

JWT_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Upstash Redis / Vercel KV (Cache & Mutex Locks)
KV_REST_API_URL="https://your-upstash-redis.upstash.io"
KV_REST_API_TOKEN="your-upstash-redis-rest-token"

# Upstash QStash (Background Job Queue & Webhooks)
QSTASH_TOKEN="your-qstash-publishing-token"
QSTASH_CURRENT_SIGNING_KEY="sig_your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="sig_your-qstash-next-signing-key"

# Application & Scheduling
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-32-char-minimum-cron-secret-value-here"

GROQ_API_KEY="gsk_your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Notifications
GMAIL_USER="notifications@yourdomain.com"
GMAIL_APP_PASSWORD="your-app-password"
